{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "typeRoots": ["../frontend/node_modules/@types"],
    "paths": {
      "react": ["../frontend/node_modules/@types/react/index.d.ts"],
      "react/*": ["../frontend/node_modules/@types/react/*"],
      "react-dom/*": ["../frontend/node_modules/@types/react-dom/*"],
      "three": ["../frontend/node_modules/@types/three/index.d.ts"],
      "*": ["../frontend/node_modules/*"]
    }
  },
  "include": ["src"]
}
